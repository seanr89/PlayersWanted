{
  "name": "players-wanted",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "functions",
    "web",
    "rules-tests"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:emulators": "firebase emulators:exec --project demo-playerswanted --only auth,firestore \"npm run test:integration --workspaces --if-present\"",
    "emulators": "firebase emulators:start --project demo-playerswanted --import .emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts",
    "dev": "npm run dev -w web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
