# Local Supabase (from `npm run db:status`). These are the public default dev keys, not secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Direct Postgres connection for integration tests (Seam 2)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Delivery worker (POST /api/notifications/dispatch). Server-side only: never expose these to the browser.
# Generate the secret with e.g. `openssl rand -hex 32`; the scheduler sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=
# Service role key from `npm run db:status` (local) or your project settings (hosted).
SUPABASE_SERVICE_ROLE_KEY=
# Where links in messages point. Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email over SMTP. Locally, Mailpit's SMTP port from supabase/config.toml (web UI: http://127.0.0.1:54324).
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="Bibleague <no-reply@bibleague.example>"
